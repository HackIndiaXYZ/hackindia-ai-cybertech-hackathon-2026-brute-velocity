# ============================================================
# Velbrix - Environment Variables (example)
# Copy to .env and fill in real values.
# NEVER commit your real .env file.
# ============================================================

# --- Primary AI Provider: NVIDIA NIM (build.nvidia.com) ---
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Fallback Provider 1: Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# --- Fallback Provider 2: Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Optional: enable model consensus (asks two providers) ---
ENABLE_MODEL_CONSENSUS=false

# --- Velbrix app settings ---
VELBRIX_PORT=8000
VELBRIX_HOST=0.0.0.0
VELBRIX_WORKSPACE_DIR=/tmp/velbrix_workspaces
VELBRIX_DB_PATH=velbrix.db
